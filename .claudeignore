# --- Build artifacts / dependencies ---
node_modules/
**/node_modules/
site/.next/
site/out/
site/next-env.d.ts
*.tsbuildinfo
package-lock.json

# --- Private / sensitive Claude Code data ---
# Mesma allowlist do .gitignore, pelo mesmo motivo: diretorio privado novo do
# Claude Code nao deve virar contexto por omissao.
.claude/*
!.claude/CLAUDE.md
!.claude/settings.json
!.claude/skills/
.claude/settings.local.json

.claude-mem/
**/.claude-mem/

# --- Environment / secrets ---
.env
.env.*
*.local
credentials*.json
*.key
*.pem

# --- Binary / generated assets ---
site/public/*.ico
site/public/*.png
site/public/*.woff2
site/app/fonts/*.woff2

# --- Static upstream copies / generated docs (never read whole; graphify noise) ---
claude/skills/
docs/DISCOVERED_SKILLS.md

# --- graphify (grafo local gerado; consultar via CLI, nao ler cru) ---
graphify-out/

# --- OS / editor noise ---
Thumbs.db
Desktop.ini
.DS_Store
*.log
.vscode/
.idea/

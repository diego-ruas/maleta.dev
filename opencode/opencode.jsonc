{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "open-websearch": {
      "type": "local",
      "command": ["cmd", "/c", "open-websearch"],
      "enabled": true,
      "environment": {
        "MODE": "stdio",
        "DEFAULT_SEARCH_ENGINE": "duckduckgo"
      }
    }
  },
  "plugin": [
    "opencode-ponytail",
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-notify",
    "opencode-worktree",
    "opencode-antigravity-auth",
    "./plugins/claude-mem.js"
  ]
}
